+import { NextResponse } from 'next/server';
+
+import { computeProviderRaceAchievements } from '@/lib/leaderboard/provider-race-achievements';
+import { publicSnowflakeReportOptions } from '@/lib/public-snowflake-report';
+
+import { GET as getProviderRace } from '../route';
+
+const CORS_HEADERS = {
+  'Access-Control-Allow-Origin': '*',
+  'Access-Control-Allow-Methods': 'GET',
+  'Access-Control-Allow-Headers': 'Content-Type',
+};
+
+// Same cache window as the underlying provider race report - this endpoint
+// only re-derives standings from that cached payload, it never queries
+// Snowflake itself.
+const CACHE_TTL_SECONDS = 3600;
+
+/**
+ * Shareable "show off" achievements for every model lab in the provider race
+ * (current rank, longest #1 reign, all-time usage champion, fastest climber,
+ * labs newly in the top 10, ...). Derived entirely from the same weekly
+ * token data as `/api/public/leaderboard-provider-race`, so it stays in sync
+ * with that report without a second Snowflake query.
+ */
+export async function GET(): Promise<NextResponse> {
+  const rows = await getProviderRace.getData();
+
+  if (rows === null) {
+    return NextResponse.json(
+      { error: 'Failed to fetch leaderboard provider race achievements' },
+      {
+        status: 502,
+        headers: { ...CORS_HEADERS, 'Cache-Control': 'no-store' },
+      }
+    );
+  }
+
+  const achievements = computeProviderRaceAchievements(rows);
+
+  return NextResponse.json(achievements, {
+    headers: {
+      ...CORS_HEADERS,
+      'Cache-Control': `public, s-maxage=${CACHE_TTL_SECONDS}, stale-while-revalidate=${CACHE_TTL_SECONDS}`,
+    },
+  });
+}
+
+export const OPTIONS = publicSnowflakeReportOptions;
