@@ -0,0 +1,136 @@
+import { ImageResponse } from 'next/og';
+
+import {
+  computeProviderRaceAchievements,
+  findProviderStanding,
+  type ProviderRaceAchievements,
+  type ProviderStanding,
+} from '@/lib/leaderboard/provider-race-achievements';
+import { publicSnowflakeReportOptions } from '@/lib/public-snowflake-report';
+
+import { GET as getProviderRace } from '../route';
+
+// Stays on the default Node.js runtime (not edge) because it reuses the
+// provider race report's data path, which depends on Node-only APIs
+// (Snowflake JWT signing, Redis). `next/og`'s ImageResponse supports both.
+const CACHE_TTL_SECONDS = 3600;
+const WIDTH = 1200;
+const HEIGHT = 630;
+
+function callout(
+  achievements: ProviderRaceAchievements,
+  standing: ProviderStanding
+): string | null {
+  if (achievements.highlights.usageChampion?.provider === standing.provider) {
+    return 'Usage Champion · most tokens across every week';
+  }
+  if (achievements.highlights.longestReign?.provider === standing.provider) {
+    return `Longest reign at #1 · ${achievements.highlights.longestReign.weeks} weeks`;
+  }
+  if (standing.enteredTop10ThisWeek) {
+    return 'Just entered the top 10';
+  }
+  if (achievements.highlights.fastestClimber?.provider === standing.provider) {
+    return `Fastest climber this week · +${achievements.highlights.fastestClimber.positions} spots`;
+  }
+  if (standing.weeksAtRank1 > 0) {
+    return `${standing.weeksAtRank1} week${standing.weeksAtRank1 === 1 ? '' : 's'} at #1`;
+  }
+  return null;
+}
+
+function errorImage(message: string): ImageResponse {
+  return new ImageResponse(
+    (
+      <div
+        style={{
+          width: '100%',
+          height: '100%',
+          display: 'flex',
+          alignItems: 'center',
+          justifyContent: 'center',
+          background: '#0b0d14',
+          color: '#f5f5f7',
+          fontSize: 32,
+        }}
+      >
+        {message}
+      </div>
+    ),
+    { width: WIDTH, height: HEIGHT }
+  );
+}
+
+/**
+ * Shareable OG-image "achievement card" for a single model lab's standing in
+ * the provider token race, e.g. `?provider=Anthropic`. Meant to be dropped
+ * into a `<meta property="og:image">` tag or shared directly - the card
+ * surfaces the lab's current rank plus whichever callout applies (usage
+ * champion, longest #1 reign, fastest climber, new to the top 10).
+ */
+export async function GET(request: Request): Promise<Response> {
+  const provider = new URL(request.url).searchParams.get('provider');
+  if (!provider) {
+    return errorImage('Add ?provider=<lab name> to share a race card.');
+  }
+
+  const rows = await getProviderRace.getData();
+  if (rows === null) {
+    return errorImage('Provider race data is temporarily unavailable.');
+  }
+
+  const achievements = computeProviderRaceAchievements(rows);
+  const standing = findProviderStanding(achievements, provider);
+  if (!standing) {
+    return errorImage(`${provider} isn't ranked in the Kilo token race yet.`);
+  }
+
+  const label = callout(achievements, standing);
+
+  const response = new ImageResponse(
+    (
+      <div
+        style={{
+          width: '100%',
+          height: '100%',
+          display: 'flex',
+          flexDirection: 'column',
+          justifyContent: 'space-between',
+          padding: 72,
+          background: 'linear-gradient(135deg, #0b0d14 0%, #171a2b 100%)',
+          color: '#f5f5f7',
+          fontFamily: 'sans-serif',
+        }}
+      >
+        <div style={{ display: 'flex', fontSize: 28, color: '#9a9fb8', letterSpacing: 2 }}>
+          KILO.AI · AI PROVIDER TOKEN RACE
+        </div>
+        <div style={{ display: 'flex', flexDirection: 'column' }}>
+          <div style={{ display: 'flex', fontSize: 96, fontWeight: 700 }}>{standing.provider}</div>
+          <div style={{ display: 'flex', fontSize: 56, color: '#5b4dff', fontWeight: 700 }}>
+            #{standing.currentRank} this week
+          </div>
+          {label ? (
+            <div style={{ display: 'flex', fontSize: 34, color: '#f5f5f7', marginTop: 12 }}>
+              {label}
+            </div>
+          ) : null}
+        </div>
+        <div style={{ display: 'flex', fontSize: 24, color: '#9a9fb8' }}>
+          Ranked by real Kilo Code token usage · kilo.ai/leaderboard/race
+        </div>
+      </div>
+    ),
+    {
+      width: WIDTH,
+      height: HEIGHT,
+      headers: {
+        'Cache-Control': `public, s-maxage=${CACHE_TTL_SECONDS}, stale-while-revalidate=${CACHE_TTL_SECONDS}`,
+      },
+    }
+  );
+
+  return response;
+}
+
+export const OPTIONS = publicSnowflakeReportOptions;
