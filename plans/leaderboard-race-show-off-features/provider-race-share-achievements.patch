+import {
+  computeProviderRaceAchievements,
+  findProviderStanding,
+  type ProviderRaceRow,
+} from './provider-race-achievements';
+
+function row(
+  weekStart: string,
+  provider: string,
+  tokens: number,
+  isOpenWeights: boolean | null = null
+): ProviderRaceRow {
+  return { weekStart, provider, isOpenWeights, tokens };
+}
+
+describe('computeProviderRaceAchievements', () => {
+  it('returns an empty result for no rows', () => {
+    const achievements = computeProviderRaceAchievements([]);
+
+    expect(achievements.latestWeekStart).toBeNull();
+    expect(achievements.weekCount).toBe(0);
+    expect(achievements.standings).toEqual([]);
+    expect(achievements.highlights.usageChampion).toBeNull();
+  });
+
+  it('excludes the "other" bucket from ranking', () => {
+    const achievements = computeProviderRaceAchievements([
+      row('2026-01-05', 'Anthropic', 100),
+      row('2026-01-05', 'other', 1_000_000),
+    ]);
+
+    expect(achievements.standings.map(s => s.provider)).toEqual(['Anthropic']);
+  });
+
+  it('ranks providers within a week by combined open/closed-weight tokens', () => {
+    const achievements = computeProviderRaceAchievements([
+      row('2026-01-05', 'Anthropic', 50, true),
+      row('2026-01-05', 'Anthropic', 50, false),
+      row('2026-01-05', 'Google', 60, false),
+    ]);
+
+    const [first, second] = achievements.standings;
+    expect(first.provider).toBe('Anthropic');
+    expect(first.currentRank).toBe(1);
+    expect(first.currentTokens).toBe(100);
+    expect(second.provider).toBe('Google');
+    expect(second.currentRank).toBe(2);
+  });
+
+  it('tracks rank change and the fastest climber across two weeks', () => {
+    const achievements = computeProviderRaceAchievements([
+      row('2026-01-05', 'Anthropic', 100),
+      row('2026-01-05', 'Google', 90),
+      row('2026-01-05', 'DeepSeek', 10),
+      row('2026-01-12', 'Anthropic', 100),
+      row('2026-01-12', 'Google', 90),
+      row('2026-01-12', 'DeepSeek', 200),
+    ]);
+
+    const deepseek = findProviderStanding(achievements, 'DeepSeek');
+    expect(deepseek?.currentRank).toBe(1);
+    expect(deepseek?.rankChange).toBe(2);
+    expect(achievements.highlights.fastestClimber).toEqual({
+      provider: 'DeepSeek',
+      positions: 2,
+    });
+  });
+
+  it('finds the longest #1 streak, allowing gaps to reset it', () => {
+    const achievements = computeProviderRaceAchievements([
+      row('2026-01-05', 'Anthropic', 100),
+      row('2026-01-05', 'Google', 10),
+      row('2026-01-12', 'Anthropic', 100),
+      row('2026-01-12', 'Google', 10),
+      row('2026-01-19', 'Google', 100),
+      row('2026-01-19', 'Anthropic', 10),
+      row('2026-01-26', 'Anthropic', 100),
+      row('2026-01-26', 'Google', 10),
+    ]);
+
+    const anthropic = findProviderStanding(achievements, 'Anthropic');
+    expect(anthropic?.weeksAtRank1).toBe(3);
+    expect(anthropic?.longestRank1Streak).toBe(2);
+    expect(achievements.highlights.longestReign).toEqual({ provider: 'Anthropic', weeks: 2 });
+  });
+
+  it('flags providers entering the top 10 for the first time this week', () => {
+    const rows: ProviderRaceRow[] = [];
+    for (let i = 1; i <= 11; i++) {
+      rows.push(row('2026-01-05', `Lab${i}`, 1000 - i));
+    }
+    rows.push(row('2026-01-12', 'Lab11', 999));
+    for (let i = 1; i <= 10; i++) {
+      rows.push(row('2026-01-12', `Lab${i}`, 1000 - i));
+    }
+
+    const achievements = computeProviderRaceAchievements(rows);
+    const lab11 = findProviderStanding(achievements, 'Lab11');
+
+    expect(lab11?.enteredTop10ThisWeek).toBe(true);
+    expect(achievements.highlights.newToTop10).toEqual(['Lab11']);
+  });
+
+  it('picks the all-time usage champion by total tokens across every week', () => {
+    const achievements = computeProviderRaceAchievements([
+      row('2026-01-05', 'Anthropic', 100),
+      row('2026-01-05', 'Google', 50),
+      row('2026-01-12', 'Anthropic', 10),
+      row('2026-01-12', 'Google', 90),
+    ]);
+
+    // Anthropic: 110 total, Google: 140 total.
+    expect(achievements.highlights.usageChampion).toEqual({ provider: 'Google', tokens: 140 });
+  });
+});
+
+describe('findProviderStanding', () => {
+  it('matches provider names case-insensitively', () => {
+    const achievements = computeProviderRaceAchievements([row('2026-01-05', 'Anthropic', 100)]);
+
+    expect(findProviderStanding(achievements, 'anthropic')?.provider).toBe('Anthropic');
+    expect(findProviderStanding(achievements, 'unknown-lab')).toBeNull();
+  });
+});
diff --git a/apps/web/src/lib/leaderboard/provider-race-achievements.ts b/apps/web/src/lib/leaderboard/provider-race-achievements.ts
new file mode 100644
index 0000000..f9d6a95
--- /dev/null
+++ b/apps/web/src/lib/leaderboard/provider-race-achievements.ts
@@ -0,0 +1,248 @@
+/**
+ * Derives shareable "show off" achievements from the same weekly
+ * provider x tokens data that powers the public provider race API
+ * (`/api/public/leaderboard-provider-race`). No new data source is
+ * introduced here: every stat below is computed purely from that
+ * payload so it stays consistent with the race chart labs already see.
+ *
+ * The `other` bucket (unmapped models, see the provider race query
+ * comment) is excluded from ranking - it is an aggregate of noise, not
+ * a lab that can claim an achievement.
+ */
+
+export type ProviderRaceRow = {
+  weekStart: string;
+  provider: string;
+  isOpenWeights: boolean | null;
+  tokens: number;
+};
+
+export type ProviderWeekStanding = {
+  provider: string;
+  rank: number;
+  tokens: number;
+  shareOfWeek: number;
+  rankChange: number | null;
+  enteredTop10ThisWeek: boolean;
+};
+
+export type ProviderStanding = {
+  provider: string;
+  currentRank: number;
+  currentTokens: number;
+  allTimeTokens: number;
+  allTimeRank: number;
+  weeksAtRank1: number;
+  longestRank1Streak: number;
+  weeksInTop3: number;
+  weeksInTop10: number;
+  rankChange: number | null;
+  enteredTop10ThisWeek: boolean;
+};
+
+export type ProviderRaceHighlights = {
+  usageChampion: { provider: string; tokens: number } | null;
+  longestReign: { provider: string; weeks: number } | null;
+  mostConsistent: { provider: string; weeksInTop3: number; weeksInTop10: number } | null;
+  fastestClimber: { provider: string; positions: number } | null;
+  newToTop10: string[];
+};
+
+export type ProviderRaceAchievements = {
+  latestWeekStart: string | null;
+  weekCount: number;
+  standings: ProviderStanding[];
+  highlights: ProviderRaceHighlights;
+};
+
+const OTHER_PROVIDER = 'other';
+
+/** Sums tokens for a provider within a week, collapsing the open/closed-weights split. */
+function tokensByWeekAndProvider(rows: ProviderRaceRow[]): Map<string, Map<string, number>> {
+  const byWeek = new Map<string, Map<string, number>>();
+
+  for (const row of rows) {
+    if (row.provider === OTHER_PROVIDER) continue;
+
+    const providers = byWeek.get(row.weekStart) ?? new Map<string, number>();
+    providers.set(row.provider, (providers.get(row.provider) ?? 0) + row.tokens);
+    byWeek.set(row.weekStart, providers);
+  }
+
+  return byWeek;
+}
+
+/** Ranks providers within a single week by tokens, highest first (rank 1 = most tokens). */
+function rankWeek(providers: Map<string, number>): ProviderWeekStanding[] {
+  const total = [...providers.values()].reduce((sum, tokens) => sum + tokens, 0);
+
+  return [...providers.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .map(([provider, tokens], index) => ({
+      provider,
+      rank: index + 1,
+      tokens,
+      shareOfWeek: total > 0 ? tokens / total : 0,
+      rankChange: null,
+      enteredTop10ThisWeek: false,
+    }));
+}
+
+export function computeProviderRaceAchievements(rows: ProviderRaceRow[]): ProviderRaceAchievements {
+  const byWeek = tokensByWeekAndProvider(rows);
+  const weeks = [...byWeek.keys()].sort();
+
+  if (weeks.length === 0) {
+    return {
+      latestWeekStart: null,
+      weekCount: 0,
+      standings: [],
+      highlights: {
+        usageChampion: null,
+        longestReign: null,
+        mostConsistent: null,
+        fastestClimber: null,
+        newToTop10: [],
+      },
+    };
+  }
+
+  const rankedWeeks = weeks.map(week => rankWeek(byWeek.get(week) ?? new Map()));
+
+  const allTimeTokens = new Map<string, number>();
+  const weeksAtRank1 = new Map<string, number>();
+  const currentRank1Streak = new Map<string, number>();
+  const longestRank1Streak = new Map<string, number>();
+  const weeksInTop3 = new Map<string, number>();
+  const weeksInTop10 = new Map<string, number>();
+  const previousRankByProvider = new Map<string, number>();
+  const firstTop10WeekIndex = new Map<string, number>();
+
+  rankedWeeks.forEach((standings, weekIndex) => {
+    const seenThisWeek = new Set<string>();
+
+    for (const standing of standings) {
+      seenThisWeek.add(standing.provider);
+      allTimeTokens.set(
+        standing.provider,
+        (allTimeTokens.get(standing.provider) ?? 0) + standing.tokens
+      );
+
+      if (standing.rank === 1) {
+        weeksAtRank1.set(standing.provider, (weeksAtRank1.get(standing.provider) ?? 0) + 1);
+        const streak = (currentRank1Streak.get(standing.provider) ?? 0) + 1;
+        currentRank1Streak.set(standing.provider, streak);
+        longestRank1Streak.set(
+          standing.provider,
+          Math.max(longestRank1Streak.get(standing.provider) ?? 0, streak)
+        );
+      } else {
+        currentRank1Streak.set(standing.provider, 0);
+      }
+
+      if (standing.rank <= 3) {
+        weeksInTop3.set(standing.provider, (weeksInTop3.get(standing.provider) ?? 0) + 1);
+      }
+      if (standing.rank <= 10) {
+        weeksInTop10.set(standing.provider, (weeksInTop10.get(standing.provider) ?? 0) + 1);
+        if (!firstTop10WeekIndex.has(standing.provider)) {
+          firstTop10WeekIndex.set(standing.provider, weekIndex);
+        }
+      }
+
+      const previousRank = previousRankByProvider.get(standing.provider);
+      standing.rankChange = previousRank !== undefined ? previousRank - standing.rank : null;
+      standing.enteredTop10ThisWeek =
+        standing.rank <= 10 && (previousRank === undefined || previousRank > 10);
+    }
+
+    // Providers absent this week keep no streak - reset their rank-1 run.
+    for (const provider of currentRank1Streak.keys()) {
+      if (!seenThisWeek.has(provider)) {
+        currentRank1Streak.set(provider, 0);
+      }
+    }
+    for (const standing of standings) {
+      previousRankByProvider.set(standing.provider, standing.rank);
+    }
+  });
+
+  const latestWeek = rankedWeeks[rankedWeeks.length - 1];
+  const allTimeRanking = [...allTimeTokens.entries()].sort((a, b) => b[1] - a[1]);
+  const allTimeRankByProvider = new Map(allTimeRanking.map(([provider], i) => [provider, i + 1]));
+
+  const standings: ProviderStanding[] = latestWeek.map(standing => ({
+    provider: standing.provider,
+    currentRank: standing.rank,
+    currentTokens: standing.tokens,
+    allTimeTokens: allTimeTokens.get(standing.provider) ?? 0,
+    allTimeRank: allTimeRankByProvider.get(standing.provider) ?? standing.rank,
+    weeksAtRank1: weeksAtRank1.get(standing.provider) ?? 0,
+    longestRank1Streak: longestRank1Streak.get(standing.provider) ?? 0,
+    weeksInTop3: weeksInTop3.get(standing.provider) ?? 0,
+    weeksInTop10: weeksInTop10.get(standing.provider) ?? 0,
+    rankChange: standing.rankChange,
+    enteredTop10ThisWeek: standing.enteredTop10ThisWeek,
+  }));
+
+  const usageChampionEntry = allTimeRanking[0];
+  const usageChampion = usageChampionEntry
+    ? { provider: usageChampionEntry[0], tokens: usageChampionEntry[1] }
+    : null;
+
+  const longestReignEntry = [...longestRank1Streak.entries()]
+    .filter(([, weeks]) => weeks > 0)
+    .sort((a, b) => b[1] - a[1])[0];
+  const longestReign = longestReignEntry
+    ? { provider: longestReignEntry[0], weeks: longestReignEntry[1] }
+    : null;
+
+  const mostConsistentEntry = [...weeksInTop3.entries()]
+    .filter(([, weeks]) => weeks > 0)
+    .sort((a, b) => {
+      const top3Diff = b[1] - a[1];
+      if (top3Diff !== 0) return top3Diff;
+      return (weeksInTop10.get(b[0]) ?? 0) - (weeksInTop10.get(a[0]) ?? 0);
+    })[0];
+  const mostConsistent = mostConsistentEntry
+    ? {
+        provider: mostConsistentEntry[0],
+        weeksInTop3: mostConsistentEntry[1],
+        weeksInTop10: weeksInTop10.get(mostConsistentEntry[0]) ?? 0,
+      }
+    : null;
+
+  const fastestClimberEntry = standings
+    .filter(standing => standing.rankChange !== null && standing.rankChange > 0)
+    .sort((a, b) => (b.rankChange ?? 0) - (a.rankChange ?? 0))[0];
+  const fastestClimber = fastestClimberEntry
+    ? { provider: fastestClimberEntry.provider, positions: fastestClimberEntry.rankChange ?? 0 }
+    : null;
+
+  const newToTop10 = standings
+    .filter(standing => standing.enteredTop10ThisWeek)
+    .map(standing => standing.provider);
+
+  return {
+    latestWeekStart: weeks[weeks.length - 1],
+    weekCount: weeks.length,
+    standings: standings.sort((a, b) => a.currentRank - b.currentRank),
+    highlights: {
+      usageChampion,
+      longestReign,
+      mostConsistent,
+      fastestClimber,
+      newToTop10,
+    },
+  };
+}
+
+export function findProviderStanding(
+  achievements: ProviderRaceAchievements,
+  provider: string
+): ProviderStanding | null {
+  const normalized = provider.trim().toLowerCase();
+  return (
+    achievements.standings.find(standing => standing.provider.toLowerCase() === normalized) ?? null
+  );
+}
