{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kilocode/kilo-cli",
  "version": "0.0.0",
  "private": true,
  "description": "The Kilo host: Kilo's CLI entry. It runs the upstream CLI and server with the Kilo plugins and service overrides.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run script/build.ts",
    "startup": "bun run script/startup.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kilocode/gateway-core": "workspace:*",
    "@kilocode/kilo-plugin": "workspace:*",
    "@opencode/ai": "workspace:*",
    "@opencode/cli": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@opencode/client": "workspace:*",
    "@opencode/server": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:"
  }
}
