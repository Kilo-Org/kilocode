    "dompurify": "3.4.16",
    "fuzzysort": "catalog:",
    "katex": "0.19.0",
    "marked": "18.0.7",
    "mermaid": "11.17.2",
    "morphdom": "2.7.8",
    "motion": "12.34.5",
    "remeda": "catalog:",
