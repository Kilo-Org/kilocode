# Source, tests and build tooling are not part of the extension package.
# `.kilo-dev` holds the `bun run extension` dev server profile: credentials, the session database and browser pairing
# keys. It sits inside the package root, so vsce would ship it without this rule.
.kilo-dev/**
.vscode/**
.github/**
node_modules/**
src/**
test/**
webview-ui/**
script/**
out/**
**/tsconfig.json
**/*.ts
**/*.tsx
**/*.map
.gitignore
.vscodeignore
bunfig.toml
knip.json

# The package ships the bundled host and webview, the CLI binary and the assets both need.
!dist/**
!bin/**
!assets/**
!THIRD_PARTY_LICENSES/**
