{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/extension.ts",
    "webview-ui/pierre-worker.ts",
    "webview-ui/src/assets.d.ts",
    "webview-ui/src/virtua.d.ts",
    "webview-ui/src/index.tsx",
    "webview-ui/src/context/language-dictionaries/*.ts",
    "tests/**/*.{ts,mts}",
    "script/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "webview-ui/**/*.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "dependencies",
    "devDependencies",
    "optionalPeerDependencies",
    "unlisted",
    "unresolved",
    "binaries"
  ]
}
