{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-project.github.io/refs/heads/json-schema/src/public/.oxlintrc.schema.json",
  "extends": ["../../.oxlintrc.json"],
  "jsPlugins": [
    { "name": "kilo-vscode", "specifier": "./script/oxlint/index.mts" }
  ],
  "overrides": [
    {
      "files": ["src/**", "webview-ui/**"],
      "rules": {
        "max-lines": ["error", 3000],
        "complexity": ["error", 20]
      }
    },
    {
      "files": ["webview-ui/agent-manager/AgentManagerApp.tsx"],
      "rules": { "max-lines": ["error", 2800] }
    },
    {
      "files": ["src/config-aliases.ts"],
      "rules": { "complexity": ["error", 21] }
    },
    {
      "files": ["src/chat.ts"],
      "rules": { "complexity": ["error", 23] }
    },
    {
      "files": ["webview-ui/src/components/settings/agent-behaviour/WorkflowsSubtab.tsx"],
      "rules": { "complexity": ["error", 23] }
    },
    {
      "files": ["webview-ui/src/components/settings/CustomProviderValidation.ts"],
      "rules": { "complexity": ["error", 25] }
    },
    {
      "files": ["webview-ui/src/components/settings/provider-visibility.ts"],
      "rules": { "complexity": ["error", 23] }
    },
    {
      "files": ["webview-ui/src/v2/question.tsx"],
      "rules": { "complexity": ["error", 29] }
    },
    {
      "files": ["webview-ui/src/v2/form.ts"],
      "rules": { "complexity": ["error", 44] }
    },
    {
      "files": [
        "src/services/autocomplete/classic-auto-complete/AutocompleteInlineCompletionProvider.ts"
      ],
      "rules": { "complexity": ["error", 28] }
    },
    {
      "files": [
        "webview-ui/src/v2/**/*.ts",
        "webview-ui/src/v2/**/*.tsx",
        "webview-ui/src/components/chat/**/*.ts",
        "webview-ui/src/components/chat/**/*.tsx",
        "webview-ui/src/components/shared/**/*.ts",
        "webview-ui/src/components/shared/**/*.tsx",
        "webview-ui/src/components/speech-to-text/**/*.ts",
        "webview-ui/src/components/speech-to-text/**/*.tsx",
        "webview-ui/diff-viewer/**/*.ts",
        "webview-ui/diff-viewer/**/*.tsx",
        "webview-ui/agent-manager/DiffPanel.tsx"
      ],
      "rules": {
        "kilo-vscode/require-view-active-guard": "error"
      }
    },
    {
      "files": [
        "webview-ui/src/v2/App.tsx",
        "webview-ui/src/v2/SettingsApp.tsx",
        "webview-ui/src/v2/chat.tsx",
        "webview-ui/src/v2/client.tsx",
        "webview-ui/src/v2/view-active.tsx",
        "webview-ui/src/v2/worktree-transfer.ts",
        "webview-ui/diff-viewer/DiffViewerApp.tsx",
        "webview-ui/diff-viewer/FullScreenDiffView.tsx"
      ],
      "rules": {
        "kilo-vscode/require-view-active-guard": "off"
      }
    }
  ]
}
