{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kilo-code-v2",
  "displayName": "Kilo Code (v2 preview)",
  "description": "Kilo Code on the Kilo v2 server",
  "publisher": "kilocode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:kilo-code.v2.settingsPanel"
  ],
  "contributes": {
    "icons": {
      "kilo-v2-logo": {
        "description": "Kilo Code (v2) logo",
        "default": {
          "fontPath": "assets/icons/kilo-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kilo-code-v2",
          "title": "Kilo Code (v2)",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "kilo-code-v2": [
        {
          "type": "webview",
          "id": "kilo-code.v2.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Kilo Code (v2)",
      "properties": {
        "kilo-code.v2.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "markdownDescription": "Font size for the Kilo Code (v2) webviews. Null follows `#editor.fontSize#`."
        },
        "kilo-code.v2.language": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language override for the Kilo Code (v2) webviews. Empty follows the VS Code display language.",
          "enum": [
            "",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs",
            "tr",
            "nl",
            "uk",
            "it",
            "fa"
          ],
          "enumDescriptions": [
            "Auto (VS Code language)",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski",
            "Türkçe",
            "Nederlands",
            "Українська",
            "Italiano",
            "فارسی"
          ]
        },
        "kilo-code.v2.chat.shiftTabCyclesVariant": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether Shift+Tab cycles the reasoning variant while the prompt input has focus."
        },
        "kilo-code.v2.showTokenThroughput": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the text-generation rate on the latest assistant message."
        },
        "kilo-code.v2.showTaskTimeline": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the task timeline graph in the chat header."
        },
        "kilo-code.v2.maxCost": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "Show a non-blocking alert when a session reaches this cost in USD. Set to 0 to disable."
        },
        "kilo-code.v2.claudeCodeCompat": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable compatibility with Claude Code configuration and rules."
        },
        "kilo-code.v2.extraCaCerts": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a file with extra CA certificates to trust."
        },
        "kilo-code.v2.languageCommitMessage": {
          "type": "string",
          "default": "sync",
          "markdownDescription": "Language of AI-generated commit messages. `sync` follows the Kilo Code UI language.",
          "enum": [
            "sync",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs",
            "tr",
            "nl",
            "uk",
            "it",
            "fa"
          ],
          "enumDescriptions": [
            "Sync with UI language",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski",
            "Türkçe",
            "Nederlands",
            "Українська",
            "Italiano",
            "فارسی"
          ]
        },
        "kilo-code.v2.autocomplete.model": {
          "type": "string",
          "enum": [
            "mistralai/codestral-2508",
            "inception/mercury-edit-2",
            "inception/mercury-next-edit",
            "codestral-2508",
            "mercury-edit-2",
            "mercury-next-edit"
          ],
          "enumDescriptions": [
            "Codestral via Kilo Gateway",
            "Mercury Edit 2 (FIM) via Kilo Gateway",
            "Mercury Edit 2 (Next Edit), multi-line edit predictions with jump-to-edit UX, via Kilo Gateway",
            "Codestral via your connected Mistral provider API key",
            "Mercury Edit 2 (FIM) via your connected Inception provider API key",
            "Mercury Edit 2 (Next Edit), multi-line edit predictions with jump-to-edit UX, via your connected Inception provider API key"
          ],
          "markdownDescription": "Model to use for inline autocomplete suggestions. If unset, the recommended default is used."
        },
        "kilo-code.v2.autocomplete.provider": {
          "type": "string",
          "enum": [
            "kilo",
            "mistral",
            "inception"
          ],
          "enumDescriptions": [
            "Use autocomplete models through Kilo Gateway",
            "Use autocomplete models through your connected Mistral provider API key",
            "Use autocomplete models through your connected Inception provider API key"
          ],
          "markdownDescription": "Provider to use for inline autocomplete suggestions. If unset, Kilo Gateway is used."
        },
        "kilo-code.v2.autocomplete.enableAutoTrigger": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable automatic inline completion suggestions."
        },
        "kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable the smart inline task keybinding (`Ctrl+L` / `Cmd+L`) that generates a suggestion at the cursor."
        },
        "kilo-code.v2.autocomplete.enableChatAutocomplete": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable autocomplete suggestions in the chat input."
        }
      }
    },
    "commands": [
      {
        "command": "kilo-code.v2.newSession",
        "title": "New Session",
        "category": "Kilo Code (v2)",
        "icon": "$(add)"
      },
      {
        "command": "kilo-code.v2.history",
        "title": "Session History",
        "category": "Kilo Code (v2)",
        "icon": "$(history)"
      },
      {
        "command": "kilo-code.v2.profile",
        "title": "Profile",
        "category": "Kilo Code (v2)",
        "icon": "$(account)"
      },
      {
        "command": "kilo-code.v2.settings",
        "title": "Settings",
        "category": "Kilo Code (v2)",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kilo-code.v2.settingsSearch",
        "title": "Search Settings",
        "category": "Kilo Code (v2)",
        "icon": "$(search)"
      },
      {
        "command": "kilo-code.v2.restartServer",
        "title": "Restart Server",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Kilo Code (v2)",
        "icon": {
          "light": "assets/icons/kilo-light.svg",
          "dark": "assets/icons/kilo-dark.svg"
        }
      },
      {
        "command": "kilo-code.v2.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.autocomplete.cancelSuggestions",
        "title": "Cancel Suggested Edits",
        "category": "Kilo Code (v2)"
      }
    ],
    "keybindings": [
      {
        "command": "kilo-code.v2.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "kilo-code.v2.sidebarFocused"
      },
      {
        "command": "kilo-code.v2.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "kilo-code.v2.sidebarFocused"
      },
      {
        "command": "kilo-code.v2.settingsSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'kilo-code.v2.settingsPanel'"
      },
      {
        "command": "kilo-code.v2.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.hasSuggestions"
      },
      {
        "command": "kilo-code.v2.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "kilo-code.v2.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kilo-code.v2.newSession",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        },
        {
          "command": "kilo-code.v2.history",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        },
        {
          "command": "kilo-code.v2.profile",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        },
        {
          "command": "kilo-code.v2.settings",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "kilo-code.v2.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "kilo-code.v2.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun script/build.ts",
    "package": "bun script/build.ts",
    "extension": "bun script/launch.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json packages/kilo-vscode/src packages/kilo-vscode/webview-ui/src packages/kilo-vscode/script packages/kilo-vscode/test",
    "test": "bun test"
  },
  "dependencies": {
    "@kilocode/gateway-core": "workspace:*",
    "@kilocode/kilo-i18n": "workspace:*",
    "@kilocode/kilo-ui": "workspace:*",
    "@kobalte/core": "catalog:",
    "@lottiefiles/dotlottie-web": "0.63.0",
    "@opencode-ai/ui": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "@pierre/diffs": "1.2.10",
    "@thisbeyond/solid-dnd": "0.7.5",
    "diff": "catalog:",
    "fastest-levenshtein": "1.0.16",
    "fuzzysort": "catalog:",
    "ignore": "7.0.5",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "3.3.1",
    "lru-cache": "11.5.2",
    "marked": "catalog:",
    "quick-lru": "7.3.0",
    "solid-js": "catalog:",
    "uri-js": "4.4.1",
    "virtua": "0.49.1",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@tsconfig/bun": "catalog:",
    "@types/babel__core": "7.20.5",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "1.95.0",
    "@typescript/native": "catalog:",
    "babel-preset-solid": "1.9.15",
    "esbuild": "0.27.2",
    "qrcode": "^1.5.4"
  }
}
