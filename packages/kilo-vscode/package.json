{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kilo-code-v2",
  "displayName": "Kilo Code (v2 preview)",
  "description": "Kilo Code on the Kilo v2 server",
  "publisher": "kilocode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kilo-code-v2",
          "title": "Kilo Code (v2)",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "kilo-code-v2": [
        {
          "type": "webview",
          "id": "kilo-code.v2.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kilo-code.v2.newSession",
        "title": "New Session",
        "category": "Kilo Code (v2)",
        "icon": "$(add)"
      },
      {
        "command": "kilo-code.v2.history",
        "title": "Session History",
        "category": "Kilo Code (v2)",
        "icon": "$(history)"
      },
      {
        "command": "kilo-code.v2.profile",
        "title": "Profile",
        "category": "Kilo Code (v2)",
        "icon": "$(account)"
      },
      {
        "command": "kilo-code.v2.restartServer",
        "title": "Restart Server",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Kilo Code (v2)"
      }
    ],
    "keybindings": [
      {
        "command": "kilo-code.v2.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "kilo-code.v2.sidebarFocused"
      },
      {
        "command": "kilo-code.v2.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "kilo-code.v2.sidebarFocused"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kilo-code.v2.newSession",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        },
        {
          "command": "kilo-code.v2.history",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        },
        {
          "command": "kilo-code.v2.profile",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun script/build.ts",
    "package": "bun script/build.ts",
    "extension": "bun script/launch.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "lint": "oxlint --config ../../.oxlintrc.json src webview-ui/src script test",
    "test": "bun test"
  },
  "dependencies": {
    "@kilocode/kilo-i18n": "workspace:*",
    "@kilocode/kilo-ui": "workspace:*",
    "@kobalte/core": "catalog:",
    "@lottiefiles/dotlottie-web": "0.63.0",
    "@opencode-ai/ui": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@pierre/diffs": "1.2.10",
    "@thisbeyond/solid-dnd": "0.7.5",
    "diff": "catalog:",
    "fuzzysort": "catalog:",
    "marked": "catalog:",
    "solid-js": "catalog:",
    "virtua": "0.49.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@tsconfig/bun": "catalog:",
    "@types/babel__core": "7.20.5",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/vscode": "1.95.0",
    "@typescript/native": "catalog:",
    "babel-preset-solid": "1.9.15",
    "esbuild": "0.27.2",
    "qrcode": "^1.5.4"
  }
}
