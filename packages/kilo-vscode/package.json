    "keybindings": [
      {
        "command": "kilo-code.v2.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "kilo-code.v2.sidebarFocused || kilo-code.v2.chatPanelFocused || activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "kilo-code.v2.sidebarFocused || kilo-code.v2.chatPanelFocused || activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.settingsSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'kilo-code.v2.settingsPanel'"
      },
      {
        "command": "kilo-code.v2.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.hasSuggestions"
      },
      {
        "command": "kilo-code.v2.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "kilo-code.v2.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "kilo-code.v2.agentManager.open",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "kilo-code.v2.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "kilo-code.v2.sidebarFocused || kilo-code.v2.chatPanelFocused || activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "kilo-code.v2.sidebarFocused || kilo-code.v2.chatPanelFocused || activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && !terminalFocus"
      },
      {
        "command": "kilo-code.v2.agentManager.search",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && !terminalFocus"
      },
      {
        "command": "kilo-code.v2.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && !kilo-code.v2.sidebarFocused"
      },
      {
        "command": "kilo-code.v2.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "kilo-code.v2.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && !kilo-code.v2.agentManager.sideTerminalFocused"
      },
      {
        "command": "kilo-code.v2.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && !kilo-code.v2.agentManager.sideTerminalFocused"
      },
      {
        "command": "kilo-code.v2.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel' && kilo-code.v2.agentManager.sideTerminalFocused"
      },
      {
        "command": "kilo-code.v2.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'kilo-code.v2.agentManagerPanel'"
      },
      {
        "command": "kilo-code.v2.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kilo-code.v2.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "kilo-code.v2.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kilo-code.v2.newSession",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@0"
        },
        {
          "command": "kilo-code.v2.history",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@1"
        },
        {
          "command": "kilo-code.v2.agentManager.open",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@2"
        },
        {
          "command": "kilo-code.v2.profile",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@3"
        },
        {
          "command": "kilo-code.v2.marketplace",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@4"
        },
        {
          "command": "kilo-code.v2.settings",
          "when": "view == kilo-code.v2.chat",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "kilo-code.v2.openInTab",
          "when": "true",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "kilo-code.v2.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "kilo-code.v2.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/context": [
        {
          "submenu": "kilo-code.v2.editorContextMenu",
          "group": "1_kilocode"
        }
      ],
      "kilo-code.v2.editorContextMenu": [
        {
          "command": "kilo-code.v2.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "kilo-code.v2.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "kilo-code.v2.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "kilo-code.v2.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "kilo-code.v2.terminalContextMenu",
          "group": "2_kilocode"
        }
      ],
      "kilo-code.v2.terminalContextMenu": [
        {
          "command": "kilo-code.v2.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "kilo-code.v2.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "kilo-code.v2.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "kilo-code.v2.agentManager.advancedWorktree",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "kilo-code.v2.editorContextMenu",
        "label": "Kilo Code"
      },
      {
        "id": "kilo-code.v2.terminalContextMenu",
        "label": "Kilo Code"
      }
    ]
  },
  "scripts": {
    "build": "bun script/build.ts",
    "package": "bun script/package.ts",
    "snapshot:build": "bun script/snapshot.ts build",
    "snapshot:install": "bun script/snapshot.ts install",
    "extension": "bun script/launch.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p webview-ui",
    "lint": "cd ../.. && oxlint --config .oxlintrc.json packages/kilo-vscode/src packages/kilo-vscode/webview-ui packages/kilo-vscode/script packages/kilo-vscode/test",
    "test": "bun test --timeout 30000"
  },
