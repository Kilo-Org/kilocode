{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "kilo-code-v2",
  "displayName": "Kilo Code (v2 preview)",
  "description": "Kilo Code on the Kilo v2 server",
  "icon": "assets/icon.png",
  "author": {
    "name": "Kilo Code"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "kilo",
    "kilo code",
    "ai",
    "agent",
    "coding agent",
    "chat",
    "autocomplete"
  ],
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "kilocode",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kilo-Org/kilocode.git",
    "directory": "packages/kilo-vscode"
  },
  "type": "commonjs",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:kilo-code.v2.settingsPanel",
    "onWebviewPanel:kilo-code.v2.profilePanel",
    "onWebviewPanel:kilo-code.v2.marketplacePanel",
    "onWebviewPanel:kilo-code.v2.agentManagerPanel",
    "onWebviewPanel:kilo-code.v2.documentsPanel",
    "onWebviewPanel:kilo-code.v2.subagentPanel",
    "onWebviewPanel:kilo-code.v2.DiffViewerPanel",
    "onWebviewPanel:kilo-code.v2.chatPanel"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "icons": {
      "kilo-v2-logo": {
        "description": "Kilo Code (v2) logo",
        "default": {
          "fontPath": "assets/icons/kilo-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kilo-code-v2",
          "title": "Kilo Code (v2)",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "kilo-code-v2": [
        {
          "type": "webview",
          "id": "kilo-code.v2.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "Kilo Code (v2)",
      "properties": {
        "kilo-code.v2.fontSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "markdownDescription": "Font size for the Kilo Code (v2) webviews. Null follows `#editor.fontSize#`."
        },
        "kilo-code.v2.language": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language override for the Kilo Code (v2) webviews. Empty follows the VS Code display language.",
          "enum": [
            "",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs",
            "tr",
            "nl",
            "uk",
            "it",
            "fa"
          ],
          "enumDescriptions": [
            "Auto (VS Code language)",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski",
            "Türkçe",
            "Nederlands",
            "Українська",
            "Italiano",
            "فارسی"
          ]
        },
        "kilo-code.v2.chat.sendWhileRunning": {
          "type": "string",
          "enum": [
            "steer",
            "queue"
          ],
          "enumDescriptions": [
            "Enter steers the running turn: the message reaches the agent after the current step. Alt+Enter queues it.",
            "Enter queues the message for after the turn. Alt+Enter steers the running turn."
          ],
          "default": "steer",
          "markdownDescription": "What Enter does when you send a message while the agent works. Alt+Enter does the other, and Cmd+Enter (Ctrl+Enter) stops the agent and sends."
        },
        "kilo-code.v2.chat.shiftTabCyclesVariant": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether Shift+Tab cycles the reasoning variant while the prompt input has focus."
        },
        "kilo-code.v2.showTokenThroughput": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the text-generation rate on the latest assistant message."
        },
        "kilo-code.v2.diff.renderMarkdown": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Render Markdown files in Kilo diff viewers by default. Toggle this from a Markdown file header in the diff viewer."
        },
        "kilo-code.v2.diff.style": {
          "type": "string",
          "enum": [
            "unified",
            "split"
          ],
          "markdownDescription": "Remembered unified/split choice for Kilo diff viewers. Set automatically the first time you toggle the style in a diff viewer."
        },
        "kilo-code.v2.showTaskTimeline": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the task timeline graph in the chat header."
        },
        "kilo-code.v2.showShortcutHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the keyboard shortcut that fits what you do now in the empty prompt, for example how to queue a prompt, add selected code, review changes, or open another worktree."
        },
        "kilo-code.v2.showAutoApprovalReason": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show why a tool call was auto-approved, such as a matching permission rule or an agent default."
        },
        "kilo-code.v2.agentWorkStyle": {
          "type": "string",
          "enum": ["unset", "human-in-the-loop", "autonomous", "skipped"],
          "enumDescriptions": [
            "No work style chosen yet; the onboarding picker is shown for a project with no sessions.",
            "Review first: ask before edits and commands, and expand tool details.",
            "High autonomy: edit and run commands in the workspace without asking, with compact tool details.",
            "The user started working without choosing a work style."
          ],
          "default": "unset",
          "markdownDescription": "The work style chosen on first run. Set by the onboarding picker."
        },
        "kilo-code.v2.indexing.showButtonWhenDisabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the indexing button below the prompt while indexing is off. If hidden, open Settings > Indexing to enable indexing."
        },
        "kilo-code.v2.maxCost": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "Show a non-blocking alert when a session reaches this cost in USD. Set to 0 to disable."
        },
        "kilo-code.v2.claudeCodeCompat": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable compatibility with Claude Code configuration and rules."
        },
        "kilo-code.v2.extraCaCerts": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a file with extra CA certificates to trust."
        },
        "kilo-code.v2.languageCommitMessage": {
          "type": "string",
          "default": "sync",
          "markdownDescription": "Language of AI-generated commit messages. `sync` follows the Kilo Code UI language.",
          "enum": [
            "sync",
            "en",
            "zh",
            "zht",
            "ko",
            "de",
            "es",
            "fr",
            "da",
            "ja",
            "pl",
            "ru",
            "ar",
            "no",
            "br",
            "th",
            "bs",
            "tr",
            "nl",
            "uk",
            "it",
            "fa"
          ],
          "enumDescriptions": [
            "Sync with UI language",
            "English",
            "简体中文",
            "繁體中文",
            "한국어",
            "Deutsch",
            "Español",
            "Français",
            "Dansk",
            "日本語",
            "Polski",
            "Русский",
            "العربية",
            "Norsk",
            "Português (Brasil)",
            "ภาษาไทย",
            "Bosanski",
            "Türkçe",
            "Nederlands",
            "Українська",
            "Italiano",
            "فارسی"
          ]
        },
        "kilo-code.v2.autocomplete.model": {
          "type": "string",
          "enum": [
            "mistralai/codestral-2508",
            "codestral-2508"
          ],
          "enumDescriptions": [
            "Codestral via Kilo Gateway",
            "Codestral via your connected Mistral provider API key"
          ],
          "markdownDescription": "Model to use for inline autocomplete suggestions. If unset, the recommended default is used."
        },
        "kilo-code.v2.autocomplete.provider": {
          "type": "string",
          "enum": [
            "kilo",
            "mistral"
          ],
          "enumDescriptions": [
            "Use autocomplete models through Kilo Gateway",
            "Use autocomplete models through your connected Mistral provider API key"
          ],
          "markdownDescription": "Provider to use for inline autocomplete suggestions. If unset, Kilo Gateway is used."
        },
        "kilo-code.v2.autocomplete.enableAutoTrigger": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable automatic inline completion suggestions."
        },
        "kilo-code.v2.autocomplete.enableSmartInlineTaskKeybinding": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable the smart inline task keybinding (`Ctrl+L` / `Cmd+L`) that generates a suggestion at the cursor."
        },
        "kilo-code.v2.autocomplete.enableChatAutocomplete": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable autocomplete suggestions in the chat input."
        },
        "kilo-code.v2.agentManager.autoBranchNaming": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically name new Agent Manager branches when the conversation describes a clear task. Explicitly named and published branches are never renamed."
        },
        "kilo-code.v2.agentManager.branchPrefix": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Prefix for automatically named Agent Manager branches, for example 'marius/' or 'feature/'. Explicit branch names are unchanged."
        },
        "kilo-code.v2.agentManager.worktreePool": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Pre-warm a ready worktree in the background so new Agent Manager sessions start faster. Uses extra disk space equal to one checkout per open project. Turn off to create worktrees only on demand."
        },
        "kilo-code.v2.agentManager.pushFixes": {
          "type": "boolean",
          "default": true,
          "description": "Agent Manager: when you send pull request CI failures or review comments to the agent, or update a worktree from its base, ask the agent to commit and push so the pull request updates. Permission prompts still apply. Disable to keep commits manual."
        },
        "kilo-code.v2.integratedBrowser": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Enable the Integrated Browser tab and the Agent Manager browser panel, and expose the `browser_open` tool to sessions. Enabled by default."
        },
        "kilo-code.v2.experimental.nativeNotebookTools": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Expose the `notebook_read`, `notebook_edit` and `notebook_execute` tools to sessions when a notebook-capable host is attached. Disabled by default."
        },
        "kilo-code.v2.experimental.conversationPromptHistory": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Keep the prompt input history (ArrowUp/ArrowDown recall) separate for each conversation instead of sharing one history across all conversations."
        },
        "kilo-code.v2.agentManager.browser.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Use system-installed Google Chrome for the Integrated Browser. Disable only when a compatible Playwright Chromium browser is already installed."
        },
        "kilo-code.v2.agentManager.browser.openLinksIn": {
          "type": "string",
          "enum": [
            "external",
            "integrated"
          ],
          "enumDescriptions": [
            "Open web links in your default browser.",
            "Open web links in a browser tab from the sidebar, or in the browser panel from Agent Manager."
          ],
          "default": "integrated",
          "scope": "application",
          "description": "Choose where web links open from Kilo chats. Requires the Integrated Browser."
        },
        "kilo-code.v2.browserAutomation.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable browser automation powered by Playwright. When enabled, the AI agent can interact with web pages in a visible Chrome window."
        },
        "kilo-code.v2.browserAutomation.useSystemChrome": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use your system's installed Chrome browser instead of downloading a separate Chromium instance."
        },
        "kilo-code.v2.browserAutomation.headless": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run browser automation in headless mode (no visible window). When disabled, you can watch the agent interact with the browser."
        }
      }
    },
    "commands": [
      {
        "command": "kilo-code.v2.newSession",
        "title": "New Session",
        "category": "Kilo Code (v2)",
        "icon": "$(add)"
      },
      {
        "command": "kilo-code.v2.history",
        "title": "Session History",
        "category": "Kilo Code (v2)",
        "icon": "$(history)"
      },
      {
        "command": "kilo-code.v2.toggleChatSearch",
        "title": "Toggle Chat Search",
        "category": "Kilo Code (v2)"
      },
      {
        "command": "kilo-code.v2.profile",
        "title": "Profile",
        "category": "Kilo Code (v2)",
        "icon": "$(account)"
