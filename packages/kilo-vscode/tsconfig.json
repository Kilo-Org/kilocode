{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": [
      "bun",
      "node"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true
  },
  "include": [
    "src",
    "script",
    "test"
  ],
  "exclude": [
    "src/shared",
    "test/fixtures/browser-panel-render.tsx",
    "test/fixtures/marketplace-render.tsx",
    "test/fixtures/marketplace-install-modal.tsx",
    "test/fixtures/prompt-toolbar-flicker.tsx"
  ]
}
