{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@kilocode/ide-ui": ["../../kilo-ide-ui/src/index.ts"],
      "@kilocode/ide-ui/*": ["../../kilo-ide-ui/src/*"],
      "@kilocode/kilo-ui": ["../../kilo-ui/src/index.ts"],
      "@kilocode/kilo-ui/*": ["../../kilo-ui/src/*"],
      "@kilocode/client/*": ["../../kilo-client/src/*"],
      "@kilocode/kilo-indexing/*": ["../../kilo-indexing/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "agent-manager/**/*",
    "kiloclaw/**/*",
    "marketplace/**/*",
    "diff-viewer/**/*",
    "diff-virtual/**/*"
  ]
}
