{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@kilocode/kilo-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "The Kilo plugins on the public OpenCode plugin API. The Kilo host (packages/kilo-cli) registers them through SdkPlugins.register.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./read": "./src/read/index.ts",
    "./request-identity": "./src/request-identity.ts",
    "./pages/auth": "./src/pages/auth.ts",
    "./plugin/git-source": "./src/plugin/git-source.ts",
    "./browser/install": "./src/browser/install.ts",
    "./browser/backend": "./src/browser/backend.ts",
    "./browser/extension": "./src/browser/extension.ts",
    "./browser/hub": "./src/browser/hub.ts",
    "./browser/png": "./src/browser/png.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test",
    "generate:browser-contract": "bun script/generate-browser-tool-contract.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kilocode/gateway-core": "workspace:*",
    "@kilocode/kilo-i18n": "workspace:*",
    "@kilocode/kilo-indexing": "workspace:*",
    "@kilocode/sandbox": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@opencode/ai": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "@playwright/mcp": "0.0.81",
    "effect": "catalog:",
    "jsonc-parser": "3.3.1",
    "mammoth": "1.12.0",
    "npm-package-arg": "13.0.2",
    "playwright-core": "1.64.0-alpha-2026-09-14",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "6.1.4",
    "@typescript/native": "catalog:",
    "@zip.js/zip.js": "2.7.62"
  }
}
