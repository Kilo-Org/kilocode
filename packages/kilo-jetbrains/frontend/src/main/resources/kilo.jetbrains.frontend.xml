<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
        <module name="intellij.terminal.frontend"/>
        <module name="kilo.jetbrains.shared"/>
    </dependencies>

    <resource-bundle>messages.KiloBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="ai.kilocode.client.onboarding.providers.v5migration.KiloMigrationService"/>
        <applicationService serviceImplementation="ai.kilocode.client.onboarding.KiloOnboardingService"/>
        <applicationService serviceImplementation="ai.kilocode.client.autocomplete.KiloAutocompleteSettingsService"/>
        <customPasteProvider implementation="ai.kilocode.client.session.ui.prompt.PromptAttachmentPasteProvider"/>

        <notificationGroup id="Kilo Code"
                           displayType="BALLOON"
                           bundle="messages.KiloBundle"
                           key="notification.group.kilo"/>

        <toolWindow id="Kilo Code"
                    anchor="left"
                    icon="/icons/kilo.svg"
                    factoryClass="ai.kilocode.client.KiloToolWindowFactory"/>

        <fileEditorProvider id="KiloVfsEditor" implementation="ai.kilocode.client.vfs.KiloFileEditorProvider"/>
        <fileEditorProvider id="KiloVfsSourceEditor"
                            order="after KiloVfsEditor"
                            implementation="ai.kilocode.client.vfs.KiloSourceEditorProvider"/>
        <fileType name="KILO_WORKTREE_SESSION"
                  implementationClass="ai.kilocode.client.agentManager.worktree.WorktreeSessionFileType"
                  fieldName="INSTANCE"/>

        <applicationConfigurable
                parentId="tools"
                id="ai.kilocode.jetbrains.settings"
                instance="ai.kilocode.client.settings.KiloSettingsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.kilo.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.profile"
                groupWeight="5"
                instance="ai.kilocode.client.settings.profile.UserProfileConfigurable"
                bundle="messages.KiloBundle"
                key="settings.profile.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.models"
                groupWeight="4"
                instance="ai.kilocode.client.settings.models.ModelsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.models.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.providers"
                groupWeight="2"
                instance="ai.kilocode.client.settings.providers.ProvidersConfigurable"
                bundle="messages.KiloBundle"
                key="settings.providers.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.agentBehavior"
                groupWeight="1"
                instance="ai.kilocode.client.settings.agents.AgentBehaviorConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.context"
                groupWeight="-1"
                instance="ai.kilocode.client.settings.context.ContextConfigurable"
                bundle="messages.KiloBundle"
                key="settings.context.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.autoApprove"
                groupWeight="0"
                instance="ai.kilocode.client.settings.autoapprove.AutoApproveConfigurable"
                bundle="messages.KiloBundle"
                key="settings.autoApprove.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.integrations"
                groupWeight="-2"
                instance="ai.kilocode.client.settings.integrations.IntegrationsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.integrations.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings"
                id="ai.kilocode.jetbrains.settings.advanced"
                groupWeight="-3"
                instance="ai.kilocode.client.settings.AdvancedConfigurable"
                bundle="messages.KiloBundle"
                key="settings.advanced.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings.agentBehavior"
                id="ai.kilocode.jetbrains.settings.agentBehavior.agents"
                instance="ai.kilocode.client.settings.agents.AgentsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.agents.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings.agentBehavior"
                id="ai.kilocode.jetbrains.settings.agentBehavior.mcp"
                instance="ai.kilocode.client.settings.agents.McpConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.mcp.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings.agentBehavior"
                id="ai.kilocode.jetbrains.settings.agentBehavior.skills"
                instance="ai.kilocode.client.settings.agents.SkillsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.skills.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings.agentBehavior"
                id="ai.kilocode.jetbrains.settings.agentBehavior.workflows"
                instance="ai.kilocode.client.settings.agents.WorkflowsConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.workflows.displayName"/>

        <applicationConfigurable
                parentId="ai.kilocode.jetbrains.settings.agentBehavior"
                id="ai.kilocode.jetbrains.settings.agentBehavior.rules"
                instance="ai.kilocode.client.settings.rules.RulesConfigurable"
                bundle="messages.KiloBundle"
                key="settings.agentBehavior.rules.displayName"/>

        <registryKey key="kilo.session.condense"
                     description="Enable event condensing in the session update queue (merges redundant snapshots before model delivery)."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="kilo.session.flushMs"
                     description="Session update queue flush cadence in milliseconds."
                     defaultValue="150"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="kilo.session.inactive.disposeTimeoutMs"
                     description="Milliseconds before hidden session UI is disposed after switching away."
                     defaultValue="180000"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="kilo.session.validateRoots"
                      description="Treat settled (non-streaming) transcript turns as Swing validate roots so their internal repaints do not relayout the whole transcript."
                      defaultValue="true"
                      restartRequired="false"
                      overrides="false"/>
        <registryKey key="kilo.diagram.inline.enabled"
                     description="Render Mermaid diagram fences inline in markdown session views."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
        <registryKey key="kilo.list.fade"
                     description="Fade list row titles and descriptions into the row background where they do not fit, instead of leaving a bare cut."
                     defaultValue="true"
                     restartRequired="false"
                     overrides="false"/>
    </extensions>

    <applicationListeners>
        <listener class="ai.kilocode.client.plugin.KiloFrontendDynamicPluginListener"
                  topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    </applicationListeners>

    <actions>
        <action id="Kilo.Restart"
                class="ai.kilocode.client.actions.RestartKiloAction"/>

        <action id="Kilo.Reinstall"
                class="ai.kilocode.client.actions.ReinstallKiloAction"/>

        <action id="Kilo.CoreInfo"
                class="ai.kilocode.client.actions.CoreInfoAction"/>

        <action id="Kilo.OpenSettings"
                class="ai.kilocode.client.actions.OpenSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Kilo.OpenLocalConfig"
                class="ai.kilocode.client.actions.OpenLocalConfigAction"/>

        <action id="Kilo.OpenGlobalConfig"
                class="ai.kilocode.client.actions.OpenGlobalConfigAction"/>

        <action id="Kilo.ForceMigration"
                class="ai.kilocode.client.actions.ForceMigrationAction"/>

        <action id="Kilo.OpenSetupScript"
                class="ai.kilocode.client.actions.OpenSetupScriptAction"/>

        <group id="Kilo.CliGroup" text="Core" popup="true">
            <reference ref="Kilo.Restart"/>
            <reference ref="Kilo.Reinstall"/>
            <separator/>
            <reference ref="Kilo.CoreInfo"/>
        </group>

        <group id="Kilo.OpenConfigGroup" text="Config Files" popup="true">
            <reference ref="Kilo.OpenLocalConfig"/>
            <reference ref="Kilo.OpenGlobalConfig"/>
            <separator/>
            <reference ref="Kilo.ForceMigration"/>
        </group>

        <group id="Kilo.SettingsGroup">
            <reference ref="Kilo.OpenSettings"/>
            <separator/>
            <reference ref="Kilo.OpenConfigGroup"/>
            <separator/>
            <reference ref="Kilo.CliGroup"/>
        </group>

        <action id="Kilo.Settings"
                class="ai.kilocode.client.actions.KiloSettingsAction"
                icon="AllIcons.General.GearPlain"/>

        <action id="Kilo.NewSession"
                class="ai.kilocode.client.actions.NewSessionAction"/>

        <action id="Kilo.NewWorktree"
                class="ai.kilocode.client.actions.NewWorktreeAction"/>

        <action id="Kilo.Chat.NewWorktree"
                class="ai.kilocode.client.actions.ChatNewWorktreeAction"
                text="New Worktree"
                description="Create a new git worktree with its own branch and session"/>

        <action id="Kilo.Chat.MoveToWorktree"
                class="ai.kilocode.client.actions.ChatMoveToWorktreeAction"
                text="Move to Worktree"
                description="Move this session into a new git worktree"/>

        <action id="Kilo.History"
                class="ai.kilocode.client.actions.HistoryAction"/>

        <!-- Declarative toolbar group for the Kilo tool window title bar -->
        <group id="Kilo.ToolWindowToolbar">
            <reference ref="Kilo.NewSession"/>
            <reference ref="Kilo.NewWorktree"/>
            <reference ref="Kilo.History"/>
            <reference ref="Kilo.Settings"/>
        </group>

        <action id="Kilo.SendPrompt"
                class="ai.kilocode.client.actions.SendPromptAction"
                text="Send Prompt"
                description="Send the current Kilo prompt">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="meta ENTER"/>
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control ENTER"/>
        </action>

        <action id="Kilo.StopSession"
                class="ai.kilocode.client.actions.StopSessionAction"
                text="Stop Session"
                description="Stop the current Kilo session">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="alt S"/>
        </action>

        <!--
          The macOS keymaps inherit from $default through MacOSDefaultKeymap, which swaps Ctrl and Cmd
          on every inherited shortcut. Ctrl+digit would therefore arrive as Cmd+digit (Cmd+1 activates
          the Project tool window), so each mac keymap re-declares the literal Ctrl shortcut with
          replace-all to drop the converted one. Same pattern the platform uses for Emmet's edit points.
        -->
        <action id="Kilo.Session.CycleMode"
                class="ai.kilocode.client.actions.CycleModeAction"
                text="Cycle Mode"
                description="Switch to the next Kilo mode">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 1"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 1"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 1"
                               replace-all="true"/>
        </action>

        <action id="Kilo.Session.CycleModel"
                class="ai.kilocode.client.actions.CycleModelAction"
                text="Cycle Model"
                description="Switch to the next favorite or recommended Kilo model">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 2"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 2"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 2"
                               replace-all="true"/>
        </action>

        <action id="Kilo.Session.CycleReasoning"
                class="ai.kilocode.client.actions.CycleReasoningAction"
                text="Cycle Reasoning Effort"
                description="Switch to the next Kilo reasoning effort">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 3"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 3"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 3"
                               replace-all="true"/>
        </action>

        <action id="Kilo.Session.ResetModel"
                class="ai.kilocode.client.actions.ResetModelAction"
                text="Reset Model"
                description="Clear the Kilo model override for the current mode">
            <keyboard-shortcut keymap="$default"
                               first-keystroke="control 0"/>
            <keyboard-shortcut keymap="Mac OS X"
                               first-keystroke="control 0"
                               replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+"
                               first-keystroke="control 0"
                               replace-all="true"/>
        </action>

        <action id="Kilo.Session.Open"
                class="ai.kilocode.client.actions.OpenSessionAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ENTER"/>
        </action>

        <action id="Kilo.Session.Rename"
                class="ai.kilocode.client.actions.RenameSessionAction"
                use-shortcut-of="RenameElement"/>

        <action id="Kilo.Session.Delete"
                class="ai.kilocode.client.actions.DeleteSessionAction"
                use-shortcut-of="$Delete"/>

        <action id="Kilo.Worktree.Rename"
                class="ai.kilocode.client.actions.RenameWorktreeAction"/>

        <action id="Kilo.Worktree.Delete"
                class="ai.kilocode.client.actions.DeleteWorktreeAction"/>

        <action id="Kilo.Worktree.OpenPr"
                class="ai.kilocode.client.actions.OpenWorktreePrAction"/>

        <action id="Kilo.Worktree.CopyPrRef"
                class="ai.kilocode.client.actions.CopyWorktreePrRefAction"/>

        <action id="Kilo.Worktree.OpenDiff"
                class="ai.kilocode.client.actions.OpenWorktreeDiffAction"/>

        <action id="Kilo.Worktree.OpenLocalDiff"
                class="ai.kilocode.client.actions.OpenWorktreeLocalDiffAction"/>

        <action id="Kilo.Worktree.CopyBranchName"
                class="ai.kilocode.client.actions.CopyBranchNameAction"/>

        <action id="Kilo.Worktree.CopyBranchPath"
                class="ai.kilocode.client.actions.CopyBranchPathAction"/>

        <action id="Kilo.Worktree.RunSetupScript"
                class="ai.kilocode.client.actions.RunWorktreeSetupScriptAction"/>

        <action id="Kilo.WorktreeSession.Rename"
                class="ai.kilocode.client.actions.RenameWorktreeSessionAction"/>

        <action id="Kilo.WorktreeSession.Delete"
                class="ai.kilocode.client.actions.DeleteWorktreeSessionAction"/>

        <action id="Kilo.WorktreeSession.MoveToWorktree"
                class="ai.kilocode.client.actions.MoveWorktreeSessionAction"/>

        <action id="Kilo.WorktreeSession.Fork"
                class="ai.kilocode.client.actions.ForkWorktreeSessionAction"/>

        <group id="Kilo.Worktree.RowMenu">
            <reference ref="Kilo.Worktree.Rename"/>
            <separator/>
            <reference ref="Kilo.Worktree.OpenPr"/>
            <reference ref="Kilo.Worktree.CopyPrRef"/>
            <reference ref="Kilo.Worktree.OpenDiff"/>
            <reference ref="Kilo.Worktree.OpenLocalDiff"/>
            <separator/>
            <reference ref="Kilo.Worktree.CopyBranchName"/>
            <reference ref="Kilo.Worktree.CopyBranchPath"/>
            <separator/>
            <reference ref="Kilo.OpenSetupScript"/>
            <reference ref="Kilo.Worktree.RunSetupScript"/>
            <separator/>
            <reference ref="Kilo.Worktree.Delete"/>
        </group>

        <group id="Kilo.WorktreeSession.RowMenu">
            <reference ref="Kilo.WorktreeSession.Fork"/>
            <reference ref="Kilo.WorktreeSession.MoveToWorktree"/>
            <separator/>
            <reference ref="Kilo.WorktreeSession.Rename"/>
            <reference ref="Kilo.WorktreeSession.Delete"/>
        </group>

        <group id="Kilo.History.ContextMenu">
            <reference ref="Kilo.Session.Open"/>
            <separator/>
            <reference ref="Kilo.Session.Rename"/>
            <reference ref="Kilo.Session.Delete"/>
        </group>

        <!-- Text and descriptions come from KiloBundle via action.<id>.text / .description. -->
        <action id="Kilo.Session.AutoApprove"
                class="ai.kilocode.client.actions.SessionAutoApproveAction"/>

        <action id="Kilo.Session.Fork"
                class="ai.kilocode.client.actions.ForkSessionAction"/>

        <action id="Kilo.Session.CompareToBase"
                class="ai.kilocode.client.actions.CompareToBaseAction"/>

        <action id="Kilo.Session.OpenPr"
                class="ai.kilocode.client.actions.OpenSessionPrAction"/>

        <action id="Kilo.Session.CopyPrRef"
                class="ai.kilocode.client.actions.CopySessionPrRefAction"/>

        <action id="Kilo.Session.CopyId"
                class="ai.kilocode.client.actions.CopySessionIdAction"/>

        <action id="Kilo.Session.Share"
                class="ai.kilocode.client.actions.ShareSessionAction"/>

        <action id="Kilo.Session.CopyShareLink"
                class="ai.kilocode.client.actions.CopyShareLinkAction"/>

        <!--
          Right-click menu inside a chat session. Every item resolves its context from
          SessionActionsKeys.ACTIONS (or PromptDataKeys.SEND) which SessionUi publishes, so the menu
          works from any point in the session. Items hide rather than disable when they do not apply,
          which keeps the menu short in the common case. New Worktree / Move to Worktree live only on
          the branch dock toolbar, not here.
        -->
        <group id="Kilo.Session.ContextMenu">
            <reference ref="Kilo.Session.AutoApprove"/>
            <separator/>
            <reference ref="Kilo.Session.Fork"/>
            <separator/>
            <reference ref="Kilo.Session.CompareToBase"/>
            <reference ref="Kilo.Session.OpenPr"/>
            <reference ref="Kilo.Session.CopyPrRef"/>
            <separator/>
            <reference ref="$Copy"/>
            <separator/>
            <reference ref="Kilo.Session.CopyId"/>
            <reference ref="Kilo.Session.CopyShareLink"/>
            <separator/>
            <reference ref="Kilo.Session.Share"/>
            <separator/>
            <reference ref="Kilo.StopSession"/>
        </group>

        <!--
          Popup shown from the "more" icon in the prompt bar. Same SessionActionsKeys.ACTIONS context
          as the context menu, with Copy and Stop reserved for the right-click menu.
        -->
        <group id="Kilo.Session.PromptMenu">
            <reference ref="Kilo.Session.AutoApprove"/>
            <separator/>
            <reference ref="Kilo.Session.Fork"/>
            <separator/>
            <reference ref="Kilo.Session.CompareToBase"/>
            <reference ref="Kilo.Session.OpenPr"/>
            <reference ref="Kilo.Session.CopyPrRef"/>
            <separator/>
            <reference ref="Kilo.Session.CopyId"/>
            <reference ref="Kilo.Session.CopyShareLink"/>
            <separator/>
            <reference ref="Kilo.Session.Share"/>
        </group>
    </actions>
</idea-plugin>
