[
  { "name": "empty pattern", "regex": "", "globs": null },
  { "name": "suffix anchor", "regex": "\\.md$", "globs": ["*.md"] },
  { "name": "wildcard pattern", "regex": ".*", "globs": ["*"] },
  { "name": "optional last character", "regex": ".*\\.tsx?$", "globs": ["*.ts", "*.tsx"] },
  { "name": "prefix alternation", "regex": "^(src|test)/", "globs": ["src/*", "test/*"] },
  { "name": "nested group", "regex": "(a|(b))\\.md$", "globs": null },
  { "name": "character class", "regex": "[a-z]\\.md$", "globs": null },
  { "name": "repeated atom", "regex": "a+\\.md$", "globs": null },
  { "name": "word boundary escape", "regex": "\\.md\\b", "globs": null },
  { "name": "anchored digits", "regex": "^123$", "globs": null },
  { "name": "anchored digit alternation", "regex": "^(123|456)$", "globs": null },
  { "name": "unanchored digits", "regex": "123", "globs": ["*123*"] },
  { "name": "unanchored empty alternative", "regex": "(|a)", "globs": ["*", "*a*"] },
  { "name": "group of empty alternatives", "regex": "(|)", "globs": ["*"] },
  { "name": "start anchored empty alternative", "regex": "^(|a)", "globs": ["*", "a*"] },
  { "name": "end anchored empty alternative", "regex": "(|a)$", "globs": ["*", "*a"] },
  { "name": "both anchored empty alternative", "regex": "^(|a)$", "globs": ["a"] },
  { "name": "both anchored trailing empty alternative", "regex": "^(a|)$", "globs": ["a"] },
  { "name": "both anchored surrounding empty alternatives", "regex": "^(|a|)$", "globs": ["a"] },
  { "name": "both anchored named alternative", "regex": "^(package\\.json|)$", "globs": ["package.json"] },
  { "name": "both anchored only empty alternatives", "regex": "^(|)$", "globs": null },
  { "name": "both anchored double empty alternatives", "regex": "^(||)$", "globs": null },
  { "name": "both anchored empty group", "regex": "^()$", "globs": null },
  { "name": "single start anchor empty alternative", "regex": "^(|)", "globs": ["*"] },
  { "name": "single start anchor surrounding empty alternatives", "regex": "^(|a|)", "globs": ["*", "a*"] },
  { "name": "home relative directory", "regex": "^~/\\.ssh/", "globs": null },
  { "name": "home relative file", "regex": "^~/\\.ssh/id_rsa$", "globs": null },
  { "name": "home bare", "regex": "^~$", "globs": null },
  { "name": "home env var", "regex": "^\\$HOME/\\.ssh/", "globs": null },
  { "name": "bare tilde", "regex": "~", "globs": ["*~*"] },
  { "name": "tilde path", "regex": "~/\\.ssh", "globs": ["*~/.ssh*"] },
  { "name": "tilde inside path", "regex": "^src/~backup/", "globs": ["src/~backup/*"] },
  { "name": "escaped no-break space", "regex": "a\\\u00a0b", "globs": null },
  { "name": "escaped figure space", "regex": "a\\\u2007b", "globs": null },
  { "name": "escaped narrow no-break space", "regex": "a\\\u202fb", "globs": null },
  { "name": "escaped roman numeral", "regex": "a\\\u2167b", "globs": null },
  { "name": "escaped euro sign", "regex": "a\\\u20acb", "globs": null },
  { "name": "escaped hyphen", "regex": "a\\-b", "globs": ["*a-b*"] },
  { "name": "escaped at sign", "regex": "a\\@b", "globs": ["*a@b*"] },
  { "name": "escaped star", "regex": "^foo\\*\\.txt$", "globs": null },
  { "name": "escaped question mark", "regex": "^foo\\?\\.txt$", "globs": null },
  { "name": "escaped backslash", "regex": "^foo\\\\bar$", "globs": null },
  { "name": "trailing literal space", "regex": "^docs ", "globs": null },
  { "name": "top-level alternation with anchors", "regex": "^src/.*|^test/.*", "globs": ["src/*", "test/*"] },
  { "name": "grouped alternation with anchors", "regex": "^(src/.*|test/.*)$", "globs": ["src/*", "test/*"] },
  { "name": "unanchored top-level alternation", "regex": "src/.*|test/.*", "globs": ["*src/*", "*test/*"] },
  { "name": "trailing empty alternative", "regex": "^foo|", "globs": ["foo*", "*"] },
  { "name": "anchor-only alternative rejects the whole pattern", "regex": "^foo|$", "globs": null },
  { "name": "unanchored single character alternatives", "regex": "a|b", "globs": ["*a*", "*b*"] },
  { "name": "escaped pipe is literal", "regex": "^a\\|b$", "globs": ["a|b"] },
  { "name": "one unsupported alternative rejects the pattern", "regex": "^src/.*|[a-z]\\.md$", "globs": null },
  { "name": "pipe inside a group", "regex": "^(a|b)/", "globs": ["a/*", "b/*"] }
]
